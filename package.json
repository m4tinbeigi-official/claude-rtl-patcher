{
  "name": "claude-rtl-patcher",
  "version": "1.2.0",
  "description": "Automated patcher to add Vazirmatn Variable font and Smart RTL support to Claude Desktop app for macOS, Windows, and Linux.",
  "main": "index.js",
  "bin": "./index.js",
  "scripts": {
    "test": "node --test",
    "build:binaries": "npx --yes @yao-pkg/pkg@6.21.0 . --public-packages '*' --output dist/claude-rtl-patcher"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m4tinbeigi-official/claude-rtl-patcher.git"
  },
  "keywords": [
    "claude",
    "rtl",
    "farsi",
    "persian",
    "arabic",
    "hebrew",
    "vazirmatn",
    "font",
    "patcher",
    "electron",
    "asar"
  ],
  "author": "Rick Sanchez & Contributors",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/m4tinbeigi-official/claude-rtl-patcher/issues"
  },
  "homepage": "https://github.com/m4tinbeigi-official/claude-rtl-patcher#readme",
  "type": "commonjs",
  "files": [
    "index.js",
    "lib",
    "assets/fonts",
    "LICENSE",
    "README.md",
    "README-FA.md",
    "README-AR.md",
    "README-HE.md"
  ],
  "pkg": {
    "scripts": [
      "index.js",
      "lib/**/*.js"
    ],
    "assets": [
      "assets/fonts/**/*"
    ]
  },
  "dependencies": {
    "@electron/asar": "^4.2.0",
    "@electron/fuses": "^1.8.0",
    "ora": "^5.4.1",
    "picocolors": "^1.1.1",
    "plist": "^3.0.6",
    "prompts": "^2.4.2"
  }
}
